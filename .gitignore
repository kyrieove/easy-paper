# Source PDFs live locally; the corpus is ~200 files and does not belong in git.
*.pdf

# Stage-1 output is regenerated from the PDF in ~2s. The evidence card is not:
# it costs a full-text model pass, so it is kept.
# Two paths because pdf2md.py's default --out moved to output/extracted; out/ is the
# older location and still holds four cards.
out/**
!out/*/
!out/*/evidence-card.json
output/extracted/**
!output/extracted/*/
!output/extracted/*/evidence-card.json

.agy-staff/
__pycache__/
tmp/
tmp_deck_inspect/
output/skill-maintenance/

# 221-PDF library, local only
01_classified_pdfs/

# Editor and tool state, not part of the skill
.obsidian/
.claudian/

# Regenerated by batch_scan.ps1 in ~10 min for 0 model tokens
output/triage.csv
